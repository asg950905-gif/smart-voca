# 2026-11-02 - smart-voca - 환경변수 예시 (복사해 .env 로 쓰되 .env 는 커밋 금지)
# 처음 실행 시 관리자 계정이 없으면 아래 값으로 생성한다 (비밀번호는 반드시 바꿀 것)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 세션 서명 키. 비워 두면 data/secret_key.txt 에 자동 생성된다. 배포 시에는 긴 무작위 값을 지정.
# SECRET_KEY=
# 기본은 본인 PC 에서만 접속(127.0.0.1). 팀 테스트 배포 시 0.0.0.0 (디버그는 켜지 말 것)
# HOST=127.0.0.1
# PORT=5000
# HTTPS 로 배포하면 1
# SESSION_COOKIE_SECURE=0
